# ============================================================
# .env.example —— 环境变量模板（复制成 .env 后填入自己的值）
#   Windows:  copy .env.example .env
#   注意：.env 含真实密钥，已在 .gitignore 里排除，不要提交 / 打包外发
# ============================================================

# ---- 1. 核心变量（决定用哪家大模型）----
# 任何 OpenAI 兼容端点都行；密钥请用自己的
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# 备用示例（同一时间只让一组生效，其余注释掉）：
# Cloudflare Workers AI（额度小、易 429）
# OPENAI_API_KEY=cfut_xxxxxxxx
# OPENAI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<account_id>/ai/v1
# OPENAI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# SiliconFlow
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# OPENAI_MODEL=tencent/Hunyuan-MT-7B

# ---- 2. 精排（CrossEncoder，开启会加载 bge-reranker-v2-m3）----
USE_RERANK=false
RERANK_TIMEOUT=3.5
# RERANK_POOL=12          （精排候选池，需 > 最终 top_k 才能"救回"排序靠后的正确段）
# RERANK_SKIP_CONF=0.75   （可选：贴合度≥此值跳过精排；默认空=不跳过）

# ---- 3. 生成与超时 ----
# LLM_TIMEOUT=30
# LLM_MAX_RETRIES=0
# ANSWER_MAX_TOKENS=800
# DOC_CHAR_LIMIT=500

# ---- 4. 检索参数（一般不用改，调优时用）----
# FUSION_CANDIDATES=8
# RETRIEVE_PER_SUB=6
# RETRIEVE_MAX_TOTAL=9
# BRIDGE_MIN_CONF=0.55
# CACHE_SEMANTIC_THRESHOLD=0.85
# PROFILE_EVERY=3
# SESSION_MAX=50
# SESSION_TTL=7200

# ---- 5. MinerU 云 API（非 txt 格式上传解析必需）----
USE_MINERU_API=false
MINERU_API_TOKEN=

# ---- 6. Cloudflare R2 对象存储（可选）----
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=
# R2_BUCKET=
